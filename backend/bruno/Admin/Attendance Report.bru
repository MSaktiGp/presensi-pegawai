meta {
  name: Attendance Report
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/api/admin/attendance-report?date=2026-11-18&user_type=all
  body: none
  auth: bearer
}

params:query {
  date: 2026-11-18
  user_type: all
}

auth:bearer {
  token: {{TOKEN}}
}

tests {
  test("should return success", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });

  test("should return attendance report data", function() {
    expect(res.body.data).to.be.an('object');
    expect(res.body.data.summary).to.be.an('object');
    expect(res.body.data.report).to.be.an('array');
  });
}
