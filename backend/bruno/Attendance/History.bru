meta {
  name: History
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/api/attendance/history?limit=10
  body: none
  auth: bearer
}

params:query {
  limit: 10
}

auth:bearer {
  token: {{TOKEN}}
}

tests {
  test("should return success", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });

  test("should return attendance history array", function() {
    expect(res.body.data).to.be.an('array');
  });
}
