meta {
  name: Today Status
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/api/attendance/today-status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{TOKEN}}
}

tests {
  test("should return success", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });

  test("should return attendance status", function() {
    expect(res.body.data).to.be.an('object');
  });
}
