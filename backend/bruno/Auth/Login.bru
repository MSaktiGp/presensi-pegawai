meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "password123"
  }
}

script:post-response {
  if (res.body.data && res.body.data.token) {
    bru.setEnvVar("TOKEN", res.body.data.token);
  }
}

tests {
  test("should return success", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });

  test("should return auth token and user profile", function() {
    expect(res.body.data).to.be.an('object');
    expect(res.body.data.token).to.be.a('string');
    expect(res.body.data.user).to.be.an('object');
  });
}
