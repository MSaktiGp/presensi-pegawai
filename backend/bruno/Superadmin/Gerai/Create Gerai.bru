meta {
  name: Create Gerai
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/superadmin/gerai
  body: json
  auth: bearer
}

auth:bearer {
  token: {{TOKEN}}
}

body:json {
  {
    "kode_gerai": "G001",
    "nama_gerai": "Gerai Pelayanan Terpadu"
  }
}

tests {
  test("should return success or duplicate error", function() {
    expect(res.status).to.be.oneOf([200, 400]);
    expect(res.body).to.be.an('object');
  });
}
