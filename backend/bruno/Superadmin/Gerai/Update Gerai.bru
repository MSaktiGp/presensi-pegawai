meta {
  name: Update Gerai
  type: http
  seq: 3
}

put {
  url: {{BASE_URL}}/api/superadmin/gerai/:id
  body: json
  auth: bearer
}

params:path {
  id: 1
}

auth:bearer {
  token: {{TOKEN}}
}

body:json {
  {
    "kode_gerai": "G001-UPDATED",
    "nama_gerai": "Gerai Updated"
  }
}

tests {
  test("should return success or error", function() {
    expect(res.status).to.be.oneOf([200, 404]);
    expect(res.body).to.be.an('object');
  });
}
