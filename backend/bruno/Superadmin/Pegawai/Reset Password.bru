meta {
  name: Reset Password
  type: http
  seq: 5
}

patch {
  url: {{BASE_URL}}/api/superadmin/pegawai/:id/reset-password
  body: json
  auth: bearer
}

params:path {
  id: 1
}

auth:bearer {
  token: {{TOKEN}}
}

body:json {
  {
    "new_password": "newpass123"
  }
}

tests {
  test("should return success or error", function() {
    expect(res.status).to.be.oneOf([200, 400, 404]);
    expect(res.body).to.be.an('object');
  });
}
