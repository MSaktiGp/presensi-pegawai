meta {
  name: Toggle Pegawai
  type: http
  seq: 4
}

patch {
  url: {{BASE_URL}}/api/superadmin/pegawai/:id/toggle
  body: none
  auth: bearer
}

params:path {
  id: 1
}

auth:bearer {
  token: {{TOKEN}}
}

tests {
  test("should return success or error", function() {
    expect(res.status).to.be.oneOf([200, 404]);
    expect(res.body).to.be.an('object');
  });
}
