meta {
  name: Update Pegawai
  type: http
  seq: 3
}

put {
  url: {{BASE_URL}}/api/superadmin/pegawai/:id
  body: json
  auth: bearer
}

params:path {
  id: 1
}

auth:bearer {
  token: {{TOKEN}}
}

body:json {
  {
    "nama": "Jane Doe",
    "username": "janedoe",
    "shift_config_id": 2
  }
}

tests {
  test("should return success or error", function() {
    expect(res.status).to.be.oneOf([200, 400, 404]);
    expect(res.body).to.be.an('object');
  });
}
