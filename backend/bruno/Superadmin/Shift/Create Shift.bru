meta {
  name: Create Shift
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/superadmin/shifts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{TOKEN}}
}

body:json {
  {
    "nama_shift": "pagi",
    "user_type": "satpam",
    "jam_masuk": "07:00",
    "jam_keluar": "15:00",
    "is_cross_midnight": false,
    "late_threshold_minutes": 60,
    "allowed_days": "1,2,3,4,5"
  }
}

tests {
  test("should return success or validation error", function() {
    expect(res.status).to.be.oneOf([200, 400]);
    expect(res.body).to.be.an('object');
  });
}
