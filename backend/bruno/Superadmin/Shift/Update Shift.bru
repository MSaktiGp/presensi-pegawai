meta {
  name: Update Shift
  type: http
  seq: 3
}

put {
  url: {{BASE_URL}}/api/superadmin/shifts/:id
  body: json
  auth: bearer
}

params:path {
  id: 1
}

auth:bearer {
  token: {{TOKEN}}
}

body:json {
  {
    "nama_shift": "pagi-updated",
    "jam_masuk": "06:30",
    "jam_keluar": "14:30"
  }
}

tests {
  test("should return success or error", function() {
    expect(res.status).to.be.oneOf([200, 400, 404]);
    expect(res.body).to.be.an('object');
  });
}
